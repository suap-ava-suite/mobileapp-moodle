+from fastapi import APIRouter, Depends
+from pydantic import BaseModel
+from app.core.dependencies import get_current_user
+from app.services.demo_content import course_for, section_for, activity_for
+from app.services.course_service import CourseService
+
+class Activity(BaseModel):
+    id: int
+    course_id: int
+    section_id: int
+    name: str
+    modname: str
+    description: str
+    completion: bool
+    url: str | None = None
+
+class Section(BaseModel):
+    id: int
+    course_id: int
+    name: str
+    activities: list[Activity]
+
+class Course(BaseModel):
+    id: int
+    name: str
+    source: str
+    environment: str
+    summary: str
+    sections: list[Section]
+
+class Profile(BaseModel):
+    username: str
+    nome: str
+
+class Card(BaseModel):
+    id: int
+    name: str
+    source: str = "mock"
+    environment: str = "demo"
+    moodle: str = "Ambiente de teste"
+
+class Dashboard(BaseModel):
+    source: str = "mock"
+    user: Profile
+    courses: list[Card]
+    diarios: list[Card]
+    coordenacoes: list[Card] = []
+    praticas: list[Card] = []
+    reutilizaveis: list[Card] = []
+    autoinscricoes: list[Card] = []
+
+router = APIRouter(prefix="/api/v1")
+@router.get("/me", response_model=Profile)
+def me(user=Depends(get_current_user)):
+    return user
+
+@router.get("/dashboard", response_model=Dashboard)
+def dashboard(user=Depends(get_current_user)):
+    cards = [Card(id=c["id"], name=c["name"]) for c in CourseService.list_courses(user["username"])]
+    return Dashboard(user=user, courses=cards, diarios=cards)
+
+@router.get("/courses/{course_id}", response_model=Course)
+def course(course_id: int, user=Depends(get_current_user)):
+    return course_for(user, course_id)
+
+@router.get("/courses/{course_id}/sections", response_model=list[Section])
+def sections(course_id: int, user=Depends(get_current_user)):
+    return course_for(user, course_id)["sections"]
+
+@router.get("/courses/{course_id}/sections/{section_id}/activities/{activity_id}", response_model=Activity)
+def activity(course_id: int, section_id: int, activity_id: int, user=Depends(get_current_user)):
+    return activity_for(user, activity_id, course_id, section_id)
