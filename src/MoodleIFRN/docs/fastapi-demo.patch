+from copy import deepcopy
+from fastapi import HTTPException
+from app.services.course_service import CourseService
+
+def course_for(user, course_id):
+    if course_id not in CourseService.COURSES or course_id not in CourseService.USER_COURSES.get(user["username"], []):
+        raise HTTPException(404, "Curso não encontrado")
+    course = deepcopy(CourseService.get_course(course_id))
+    course.update(source="mock", environment="demo", moodle="Ambiente de teste")
+    for si, section in enumerate(course["sections"], 1):
+        section.update(id=course_id * 100 + si, course_id=course_id)
+        for ai, activity in enumerate(section["activities"], 1):
+            activity.update(id=section["id"] * 100 + ai, section_id=section["id"], course_id=course_id,
+                            description="Conteúdo fictício de teste", url=None)
+    return course
+
+def section_for(user, section_id):
+    course = course_for(user, section_id // 100)
+    for section in course["sections"]:
+        if section["id"] == section_id:
+            return section
+    raise HTTPException(404, "Seção não encontrada")
+
+def activity_for(user, activity_id, course_id=None, section_id=None):
+    section = section_for(user, activity_id // 100)
+    if (course_id is not None and section["course_id"] != course_id) or (section_id is not None and section["id"] != section_id):
+        raise HTTPException(404, "Atividade não encontrada")
+    for activity in section["activities"]:
+        if activity["id"] == activity_id:
+            return activity
+    raise HTTPException(404, "Atividade não encontrada")
